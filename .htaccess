Options -Indexes
DirectorySlash Off
RewriteEngine On

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteRule ^(?:database|deploy)/ - [F,L]

RewriteRule ^admin/login/?$ index.php?route=admin/login [QSA,L]
RewriteRule ^admin/?$ index.php?route=admin/dashboard [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/?$ index.php?route=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^$ index.php [QSA,L]
